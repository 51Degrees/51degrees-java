<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <properties>
        <!-- Selenium ships Java 11 class files from 4.14.0 onwards, so the
             browser tests are built and run on the Java 11+ legs only. See
             the profiles at the end of this file. -->
        <selenium.version>4.46.0</selenium.version>
    </properties>
    <parent>
        <groupId>com.51degrees</groupId>
        <artifactId>pipeline</artifactId>
        <version>4.5.127-SNAPSHOT</version>
    </parent>
    <artifactId>pipeline.javascriptbuilder</artifactId>
    <packaging>jar</packaging>

    <name>51Degrees :: Pipeline :: Java Script Builder</name>
    <url>https://github.com/51Degrees/51degrees-java</url>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>pipeline.jsonbuilder</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.github.spullara.mustache.java</groupId>
            <artifactId>compiler</artifactId>
            <version>${mustache-compiler.version}</version>
        </dependency>
        <!-- Minifies the script, as the specification asks of an existing
             third-party library. It names a log4j binding for SLF4J as a
             compile dependency, which would take over the logging of every
             application using this package, so that is left out. -->
        <dependency>
            <groupId>net.logicsquad</groupId>
            <artifactId>minifier</artifactId>
            <version>${minifier.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j-impl</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.graalvm.js</groupId>
            <artifactId>js-scriptengine</artifactId>
            <version>${graal-js-scriptengine.version}</version>
        </dependency>
        <dependency>
            <groupId>org.graalvm.js</groupId>
            <artifactId>js</artifactId>
            <version>${graal-js.version}</version>
        </dependency>

        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>pipeline.engines</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>pipeline.common</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Selenium 4.14.0 moved to Java 11 class files, and the last release
             that still runs on Java 8 (4.13.0) bundles a Selenium Manager that
             pairs a stale cached ChromeDriver with current Chrome, failing with
             "This version of ChromeDriver only supports Chrome version NNN".
             No Selenium version both runs on Java 8 and drives a current
             browser, so JavaScriptBuilderTests, which uses Selenium, is built
             and run on Java 11 and later only. Every test in that class needs
             a browser.

             The rest of the module's tests are compiled against the Java 8
             API, as the parent sets. JavaScriptBuilderTests is compiled on
             its own against the Java 11 API, because Selenium marks some of
             its classes @Deprecated(since, forRemoval), which the Java 8 API
             has no elements for, so javac warns that it cannot find them when
             it reads those classes for Java 8. -->
        <profile>
            <id>jdk11-selenium</id>
            <activation>
                <jdk>[11,)</jdk>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>default-testCompile</id>
                                <configuration>
                                    <testExcludes>
                                        <testExclude>**/JavaScriptBuilderTests.java</testExclude>
                                    </testExcludes>
                                </configuration>
                            </execution>
                            <execution>
                                <id>selenium-testCompile</id>
                                <phase>test-compile</phase>
                                <goals>
                                    <goal>testCompile</goal>
                                </goals>
                                <configuration>
                                    <testIncludes>
                                        <testInclude>**/JavaScriptBuilderTests.java</testInclude>
                                    </testIncludes>
                                    <testRelease>11</testRelease>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
            <dependencies>
                <dependency>
                    <groupId>org.seleniumhq.selenium</groupId>
                    <artifactId>selenium-java</artifactId>
                    <version>${selenium.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>

        <!-- When Maven runs on JDK 11 or later and the tests run on a Java 8
             JVM, given by Surefire's jvm property, the test run leaves out
             JavaScriptBuilderTests, as Java 8 cannot load its Java 11 class
             file. Set fiftyone.testJava to 8 to choose this. -->
        <profile>
            <id>java-8-test-jvm</id>
            <activation>
                <property>
                    <name>fiftyone.testJava</name>
                    <value>8</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>**/*$*</exclude>
                                <exclude>**/JavaScriptBuilderTests.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- On Java 8 the Selenium tests are dropped at test *compilation*, not
             just from the test run: javac fails reading the Java 11 class files
             ("class file has wrong version 55.0, should be 52.0") long before
             surefire is reached, so a surefire <excludes> alone would not help.
             CI compiles with JDK 17 and then runs the tests with Maven on
             JDK 8, so the class compiled for Java 11 is also left out of the
             test run there. The module's other tests are unaffected. -->
        <profile>
            <id>jdk8-no-selenium</id>
            <activation>
                <jdk>(,11)</jdk>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <testExcludes>
                                <testExclude>**/JavaScriptBuilderTests.java</testExclude>
                            </testExcludes>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <!-- Surefire's own default, which a list
                                     given here replaces. -->
                                <exclude>**/*$*</exclude>
                                <exclude>**/JavaScriptBuilderTests.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>