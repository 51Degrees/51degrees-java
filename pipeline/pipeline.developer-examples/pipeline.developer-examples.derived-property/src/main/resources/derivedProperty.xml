<!--
  The Derived Property Element example's pipeline, built from this file
  rather than from code. The element that supplies the source properties
  comes first. The Derived Property Element is named by its builder, and the
  script is passed through its build parameters:

  - ScriptFiles: a comma separated list of script files, where a file name
    may hold a wildcard, such as derived/*.yaml. A relative path that is not
    found from the working directory is searched for below it.
  - Scripts: a comma separated list of built-in script names. This package
    embeds no scripts.

  Script text given in code is not available from a configuration file.
-->
<PipelineOptions>
    <Elements>
        <Element>
            <BuilderName>SensorElement</BuilderName>
        </Element>
        <Element>
            <BuilderName>DerivedPropertyElement</BuilderName>
            <BuildParameters>
                <ScriptFiles>derived/FrostRisk.yaml</ScriptFiles>
            </BuildParameters>
        </Element>
    </Elements>
</PipelineOptions>
