<PipelineOptions>
    <Elements>
        <!-- The element that supplies the source properties. A real
             Pipeline puts device detection or IP intelligence here, and
             this example has a small element of its own so that it needs
             no resource key, no data file and no network. -->
        <Element>
            <BuilderName>SessionElement</BuilderName>
        </Element>
        <Element>
            <BuilderName>DerivedPropertyElement</BuilderName>
            <BuildParameters>
                <!-- Scripts names the scripts built into the
                     pipeline.derivedproperty package, which come from the
                     51Degrees derived-properties repository, as a list
                     with a comma between names. The line below shows the
                     shape to copy, and stays a comment so that this
                     example does not depend on that repository's content.

                <Scripts>HumanConfidence</Scripts>
                -->

                <!-- ScriptFiles names scripts in your own environment, as a
                     list with a comma between paths. A path is relative to
                     the working directory or absolute, and its file name
                     may hold a wildcard, so derived/*.yaml adds every
                     script in a folder. ${filepath:...} finds the file
                     below the working directory, so the example runs from
                     any folder of the repository. -->
                <ScriptFiles>${filepath:ReaderEngagement.yaml}</ScriptFiles>
            </BuildParameters>
        </Element>
    </Elements>
</PipelineOptions>
