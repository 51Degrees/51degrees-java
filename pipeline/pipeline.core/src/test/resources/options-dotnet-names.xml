<?xml version="1.0" encoding="utf-8" ?>
<!-- The structure and names of the .NET sample configuration file,
     examples/device-detection/sample-configuration.json in 51degrees-dotnet,
     written as XML: builder names with the 'Builder' suffix, and builder
     method names with the 'Set' prefix, at element and Pipeline level. -->
<PipelineOptions>
    <Elements>
        <Element>
            <BuilderName>MultiplyByElementBuilder</BuilderName>
            <BuildParameters>
                <multiple>8</multiple>
            </BuildParameters>
        </Element>
    </Elements>
    <BuildParameters>
        <SetAutoDisposeElements>true</SetAutoDisposeElements>
        <SetSuppressProcessException>false</SetSuppressProcessException>
    </BuildParameters>
</PipelineOptions>
