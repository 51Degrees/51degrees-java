<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.51degrees</groupId>
        <artifactId>pipeline</artifactId>
        <version>4.5.127-SNAPSHOT</version>
    </parent>
    <artifactId>pipeline.derivedproperty</artifactId>
    <packaging>jar</packaging>

    <name>51Degrees :: Pipeline :: Derived Property</name>
    <description>The Derived Property Element produces new property values from property values other elements in the Pipeline have already produced, following rules written in a script.</description>
    <url>https://github.com/51Degrees/51degrees-java</url>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>pipeline.engines</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>pipeline.core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Scripts are read with the compose API, which gives every node
             its line, and plain scalars are resolved here by the YAML 1.2
             core schema, so "yes" stays the string "yes". -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- The built-in scripts, straight from the derived-properties
                 submodule rather than a copy. BuiltInScript names each one,
                 and BuiltInScriptTests fails when the two differ. -->
            <resource>
                <directory>../derived-properties/scripts</directory>
                <targetPath>fiftyone/pipeline/derivedproperty/scripts</targetPath>
                <includes>
                    <include>*.yaml</include>
                    <include>*.yml</include>
                    <include>*.json</include>
                </includes>
            </resource>
        </resources>
    </build>
</project>
